---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Z NACELLES | Nacelliste Professionnel — Mérignac (33) | Toute la France"
  description="Z NACELLES, nacelliste professionnel basé à Mérignac (33). Conduite de nacelles élévatrices, habilitations électriques BT/HT, CACES® R486, accès sites nucléaires. Devis gratuit, intervention sur toute la France."
>
  <!-- === NAV === -->
  <header>
    <nav class="nav" id="nav" role="navigation" aria-label="Navigation principale">
      <a href="#hero" class="logo"><span>Z</span> NACELLES</a>
      <ul class="nav-links" id="navLinks">
        <li><a href="#about">À propos</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#certifs">Certifications</a></li>
        <li><a href="#contact" class="cta-link">Contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <main>
    <!-- === HERO === -->
    <section class="hero" id="hero">
      <div class="hero-inner">
        <h1 class="sr"><span>Z</span> NACELLES</h1>
        <p class="tagline sr sr-d1">
          Nacelliste professionnel basé à Mérignac.<br />
          Conduite de nacelles élévatrices sur toute la France.
        </p>
        <div class="hero-buttons sr sr-d2">
          <a href="#contact" class="btn btn-fill">Demander un devis</a>
          <a href="#services" class="btn btn-outline">Nos services</a>
        </div>
        <div class="hero-keys sr sr-d3">
          <div class="hero-key">
            <div class="label">Certification</div>
            <div class="value">CACES® R486</div>
          </div>
          <div class="hero-key">
            <div class="label">Habilitations</div>
            <div class="value">BT / HT</div>
          </div>
          <div class="hero-key">
            <div class="label">Zone</div>
            <div class="value">Toute la France</div>
          </div>
        </div>
      </div>
    </section>

    <!-- === ABOUT === -->
    <section id="about">
      <div class="about-grid">
        <div class="section-header sr">
          <div class="section-label">À propos</div>
          <h2 class="section-title">Un nacelliste, pas un commercial</h2>
          <div class="about-text">
            <p>
              <strong>Z NACELLES</strong>, c'est avant tout un professionnel du terrain. Basé à Mérignac (33), j'interviens directement sur vos chantiers pour la conduite de nacelles élévatrices.
            </p>
            <p>
              Formé et certifié, j'apporte un savoir-faire concret en travaux en hauteur : maintenance industrielle, chantiers BTP, sites nucléaires, travaux à proximité de lignes électriques. Toutes mes habilitations sont à jour.
            </p>
            <p>
              L'entreprise est récente, mais l'expérience est là. Chaque intervention est réalisée dans le strict respect des normes de sécurité.
            </p>
          </div>
          <div class="about-tags">
            <div class="about-tag"><span class="check">✓</span> CACES® R486</div>
            <div class="about-tag"><span class="check">✓</span> Habilitations BT/HT</div>
            <div class="about-tag"><span class="check">✓</span> Accès nucléaire</div>
            <div class="about-tag"><span class="check">✓</span> Mobilité nationale</div>
          </div>
        </div>
        <div class="about-photo sr sr-d2" role="img" aria-label="Photo Z NACELLES">
          <span class="ph-icon">📷</span>
          <span>Votre photo ici</span>
        </div>
      </div>
    </section>

    <!-- === SERVICES === -->
    <section id="services">
      <div class="section-header center sr">
        <div class="section-label">Services</div>
        <h2 class="section-title">Ce que je fais</h2>
        <p class="section-desc">Des prestations claires, un interlocuteur unique, du matériel certifié.</p>
      </div>
      <div class="services-grid">
        <article class="s-card sr sr-d1">
          <span class="s-icon">🏗️</span>
          <h3>Travaux en hauteur</h3>
          <p>Conduite de nacelles pour vos interventions en hauteur : maintenance, pose, inspection, nettoyage.</p>
        </article>
        <article class="s-card sr sr-d2">
          <span class="s-icon">⚡</span>
          <h3>Habilitations électriques</h3>
          <p>Habilité BT et HT pour intervenir en toute sécurité à proximité de lignes et installations électriques.</p>
        </article>
        <article class="s-card sr sr-d3">
          <span class="s-icon">📋</span>
          <h3>CACES® R486</h3>
          <p>PEMP B (1B-3B) — Conduite certifiée de plateformes élévatrices mobiles. Certification à jour.</p>
        </article>
        <article class="s-card sr sr-d4">
          <span class="s-icon">☢️</span>
          <h3>Sites nucléaires</h3>
          <p>Accrédité pour intervenir sur sites sensibles et nucléaires. Protocoles de sécurité renforcés maîtrisés.</p>
        </article>
        <article class="s-card sr sr-d5">
          <span class="s-icon">🚛</span>
          <h3>Déplacement France entière</h3>
          <p>Basé en Gironde, je me déplace sur vos chantiers partout en France métropolitaine.</p>
        </article>
      </div>
    </section>

    <!-- === CERTIFICATIONS === -->
    <section id="certifs">
      <div class="section-header center sr">
        <div class="section-label">Qualifications</div>
        <h2 class="section-title">Certifications & Habilitations</h2>
        <p class="section-desc">Toutes mes certifications sont valides et vérifiables.</p>
      </div>
      <div class="certifs-grid">
        <div class="certif-item sr sr-d1">
          <span class="c-icon">📋</span>
          <h3>CACES® PEMP B</h3>
          <p>R486 Cat. 1B & 3B</p>
        </div>
        <div class="certif-item sr sr-d2">
          <span class="c-icon">⚡</span>
          <h3>Habilitation BT</h3>
          <p>Basse Tension</p>
        </div>
        <div class="certif-item sr sr-d3">
          <span class="c-icon">🔴</span>
          <h3>Habilitation HT</h3>
          <p>Haute Tension</p>
        </div>
        <div class="certif-item sr sr-d4">
          <span class="c-icon">☢️</span>
          <h3>Accès nucléaire</h3>
          <p>Sites sensibles</p>
        </div>
      </div>
    </section>

    <!-- === CTA === -->
    <div class="cta-banner sr">
      <h2>Un projet ? Parlons-en.</h2>
      <p>Devis gratuit sous 24h, déplacement sur toute la France.</p>
      <a href="#contact" class="btn btn-fill">Demander un devis</a>
      <div>
        <a href="tel:+33767341655" class="cta-phone">📞 07 67 34 16 55</a>
      </div>
    </div>

    <!-- === CONTACT === -->
    <section id="contact">
      <div class="section-header center sr">
        <div class="section-label">Contact</div>
        <h2 class="section-title">Contactez-moi</h2>
        <p class="section-desc">Décrivez votre besoin, je vous réponds rapidement.</p>
      </div>
      <div class="contact-grid">
        <form class="contact-form sr" id="contactForm" aria-label="Formulaire de contact">
          <div class="field">
            <label for="name">Nom</label>
            <input type="text" id="name" placeholder="Votre nom" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" placeholder="votre@email.com" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Téléphone</label>
            <input type="tel" id="phone" placeholder="06 00 00 00 00" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" placeholder="Décrivez votre besoin..." required></textarea>
          </div>
          <button type="submit" class="form-btn">Envoyer</button>
        </form>

        <div class="contact-details sr sr-d2">
          <div class="c-item">
            <div class="c-i-icon">📞</div>
            <div>
              <h4>Téléphone</h4>
              <a href="tel:+33767341655">07 67 34 16 55</a>
            </div>
          </div>
          <div class="c-item">
            <div class="c-i-icon">✉️</div>
            <div>
              <h4>Email</h4>
              <a href="mailto:z.nacelles@gmail.com">z.nacelles@gmail.com</a>
            </div>
          </div>
          <div class="c-item">
            <div class="c-i-icon">📍</div>
            <div>
              <h4>Adresse</h4>
              <p>26 av. Gustave Eiffel, 33700 Mérignac</p>
            </div>
          </div>
          <div class="c-item">
            <div class="c-i-icon">🗺️</div>
            <div>
              <h4>Zone d'intervention</h4>
              <p>Toute la France</p>
            </div>
          </div>
          <div class="contact-map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2829.7!2d-0.6413!3d44.8314!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd54d86b2c4f2e43%3A0x0!2s26+Avenue+Gustave+Eiffel%2C+33700+M%C3%A9rignac!5e0!3m2!1sfr!2sfr!4v1700000000000!5m2!1sfr!2sfr"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Z NACELLES — 26 avenue Gustave Eiffel, 33700 Mérignac"
            >
            </iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- === FOOTER === -->
  <footer>
    <div class="footer-top">
      <div class="footer-brand">
        <div class="f-logo"><span>Z</span> NACELLES</div>
        <p>Nacelliste professionnel basé à Mérignac. CACES® R486, habilitations électriques, accès nucléaire.</p>
      </div>
      <div class="footer-col">
        <h4>Navigation</h4>
        <a href="#about">À propos</a>
        <a href="#services">Services</a>
        <a href="#certifs">Certifications</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <a href="#services">Travaux en hauteur</a>
        <a href="#services">Habilitations électriques</a>
        <a href="#services">CACES® R486</a>
        <a href="#services">Sites nucléaires</a>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <a href="tel:+33767341655">07 67 34 16 55</a>
        <a href="mailto:z.nacelles@gmail.com">z.nacelles@gmail.com</a>
        <a href="#contact">Demander un devis</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2025 Z NACELLES — Tous droits réservés</p>
    </div>
  </footer>

  <!-- WhatsApp -->
  <a
    href="https://wa.me/33767341655"
    target="_blank"
    rel="noopener noreferrer"
    class="wa-btn"
    aria-label="WhatsApp"
    title="Nous contacter sur WhatsApp"
  >
    <svg viewBox="0 0 24 24">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
  </a>

  <!-- Back to top -->
  <button class="to-top" id="toTop" aria-label="Retour en haut">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 15l-6-6-6 6"></path>
    </svg>
  </button>
</Layout>
