---
import Layout from '../layouts/Layout.astro';
import ZLogo from '../components/ZLogo.astro';
---

<Layout
  title="Z NACELLES | Nacelliste Professionnel — Spécialiste Télécoms, Pylônes 4G/5G & Grandes Hauteurs | Mérignac (33)"
  description="Z NACELLES — Nacelliste professionnel certifié. Déploiement et maintenance Télécoms (pylônes, antennes 4G/5G), habilitation travaux en hauteur, habilitations électriques BT & HT, CACES® PEMP B R486, accès sites nucléaires. Mobilité France entière."
>
  <!-- === NAVBAR === -->
  <header>
    <nav class="nav" id="nav" role="navigation" aria-label="Navigation principale">
      <a href="#hero" class="nav-brand" aria-label="Z NACELLES - Accueil">
        <ZLogo width={36} height={36} className="brand-emblem" />
        <div class="brand-text-block">
          <span class="brand-title">Z NACELLES</span>
          <span class="brand-subtitle">Nacelliste Professionnel</span>
        </div>
      </a>
      <ul class="nav-links" id="navLinks">
        <li><a href="#services">Services</a></li>
        <li><a href="#telecom">Télécoms</a></li>
        <li><a href="#galerie">Réalisations</a></li>
        <li><a href="#about">À propos</a></li>
        <li><a href="#contact" class="nav-cta">Contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <main>
    <!-- === HERO SECTION === -->
    <section class="hero" id="hero">
      <div class="hero-container">
        <div class="hero-logo-box sr">
          <img
            src="/images/logo-znacelles-transparent.png"
            alt="Z NACELLES — Nacelliste Professionnel"
            class="hero-official-logo"
            width="420"
            height="210"
            style="max-width: 90vw; width: 380px; height: auto; margin: 0 auto 14px; filter: drop-shadow(0 0 35px rgba(0, 212, 255, 0.4)); display: block;"
          />
          <h1 style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">Z NACELLES</h1>
          <div class="hero-badge-tag">Nacelliste Professionnel • Spécialiste Télécoms & Grandes Hauteurs</div>
        </div>

        <p class="hero-desc sr sr-d1">
          Partenaire de référence pour vos interventions en hauteur : <strong>déploiement et maintenance de réseaux Télécoms (pylônes, antennes 4G/5G, FH)</strong>, chantiers BTP, industrie et réseaux d'énergie. Conduite experte, matériel certifié et mobilité sur toute la France.
        </p>

        <div class="hero-actions sr sr-d2">
          <a href="#contact" class="btn btn-primary">
            Demander un devis
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="tel:+33767341655" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            07 67 34 16 55
          </a>
        </div>

        <!-- Contact bar directly from card footer -->
        <div class="hero-card-strip sr sr-d3">
          <div class="strip-item">
            <span>📞</span>
            <a href="tel:+33767341655">07 67 34 16 55</a>
          </div>
          <span class="strip-dot">■</span>
          <div class="strip-item">
            <span>✉️</span>
            <a href="mailto:z.nacelles@gmail.com">z.nacelles@gmail.com</a>
          </div>
          <span class="strip-dot">■</span>
          <div class="strip-item">
            <span>📍</span>
            <span>26 av. Gustave Eiffel, 33700 MÉRIGNAC</span>
          </div>
        </div>
      </div>
    </section>

    <!-- === BUSINESS CARD SHOWCASE SECTION === -->
    <div class="business-card-section sr">
      <div class="card-showcase-grid">
        <!-- Front Card Preview -->
        <div class="card-preview-box card-front">
          <div>
            <img
              src="/images/logo-znacelles-transparent.png"
              alt="Z NACELLES Logo"
              style="max-width: 250px; width: 85%; height: auto; margin: 0 auto 10px; display: block;"
            />
            <div class="card-front-sub">NACELLISTE PROFESSIONNEL</div>
          </div>
          <div class="card-front-contact">
            <div>07 67 34 16 55 <span class="sq">■</span> z.nacelles@gmail.com</div>
            <div>26 av. Gustave Eiffel <span class="sq">■</span> 33700 MÉRIGNAC</div>
          </div>
        </div>

        <!-- Back Card Preview -->
        <div class="card-preview-box card-back">
          <div class="card-back-title">Domaines d'intervention & Habilitations</div>
          <ul class="card-back-list">
            <li>
              <span class="glow-bullet"></span>
              <span>Télécoms & Pylônes relais 4G/5G</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Habilitation Travaux en Hauteur & Port du Harnais</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Habilitations électriques BT & HT</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>CACES® PEMP B (1B-3B) R486</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Accès sites nucléaires & industriels</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Mobilité sur toute la France</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- === TELECOM FOCUS SECTION === -->
    <section id="telecom" style="background: linear-gradient(180deg, #090a0f 0%, #0d0f17 100%); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
      <div class="section-header center sr">
        <div class="section-label" style="color: var(--cyan);">Activité Principale</div>
        <h2 class="section-title">Spécialiste Réseaux Télécoms & Pylônes</h2>
        <p class="section-desc">
          Partenaire privilégié des opérateurs, intégrateurs et équipementiers télécoms pour tous leurs besoins d'accès et d'assistance nacelle en hauteur.
        </p>
      </div>

      <div class="services-grid" style="max-width: 1150px; margin: 0 auto 30px;">
        <article class="service-card sr sr-d1" style="border-color: rgba(0, 212, 255, 0.3); background: rgba(0, 212, 255, 0.03);">
          <div class="service-num">📡 Télécom 01</div>
          <h3>Pylônes Relais 4G & 5G</h3>
          <p>
            Positionnement précis et sécurisé de la nacelle pour l'installation, le réglage azimut/tilt et le remplacement d'antennes panneaux et baies radio sur pylônes tubulaires, treillis et châteaux d'eau.
          </p>
        </article>

        <article class="service-card sr sr-d2" style="border-color: rgba(0, 212, 255, 0.3); background: rgba(0, 212, 255, 0.03);">
          <div class="service-num">🌐 Télécom 02</div>
          <h3>Faisceaux Hertziens (FH) & Mâts</h3>
          <p>
            Assistance au pointage de paraboles FH, tirage de jarretières et câblage coaxial/fibre optique le long des infrastructures de télécommunication en hauteur.
          </p>
        </article>

        <article class="service-card sr sr-d3" style="border-color: rgba(0, 212, 255, 0.3); background: rgba(0, 212, 255, 0.03);">
          <div class="service-num">🏢 Télécom 03</div>
          <h3>Toitures-Terrasses & Sites Urbains</h3>
          <p>
            Intervention en milieu urbain dense et sites complexes sur toits d'immeubles, terrasses et façades avec grand déport latéral et sécurisation du périmètre au sol.
          </p>
        </article>
      </div>
    </section>

    <!-- === SERVICES SECTION (DIRECTLY FROM CARD & SKILLS) === -->
    <section id="services">
      <div class="section-header center sr">
        <div class="section-label">Expertises & Certifications</div>
        <h2 class="section-title">Nos Prestations & Habilitations</h2>
        <p class="section-desc">
          Une réponse rigoureuse, sécurisée et certifiée pour chacun de vos chantiers en hauteur.
        </p>
      </div>

      <div class="services-grid">
        <!-- 1. Grandes hauteurs -->
        <article class="service-card sr sr-d1">
          <div class="service-num">01 / Spécialité</div>
          <h3>Interventions Grandes Hauteurs</h3>
          <p>
            Solutions sur mesure adaptées aux contraintes techniques de votre site. Maintenance, levage, montage, nettoyage et inspections techniques en hauteur avec positionnement millimétré.
          </p>
        </article>

        <!-- 2. Habilitation Travaux en Hauteur -->
        <article class="service-card sr sr-d2" style="border-color: rgba(0, 212, 255, 0.25);">
          <div class="service-num">02 / Sécurité</div>
          <h3>Habilitation Travaux en Hauteur & Harnais</h3>
          <p>
            Certification et formation complète aux travaux en hauteur : port et vérification des EPI de classe 3 (harnais, longes, antichute), respect strict des règles de sécurité et balisage de zone.
          </p>
        </article>

        <!-- 3. Habilitations électriques -->
        <article class="service-card sr sr-d3">
          <div class="service-num">03 / Énergie</div>
          <h3>Habilitations Électriques BT & HT</h3>
          <p>
            Opérateur habilité Basse Tension (BT) et Haute Tension (HT) pour des manœuvres et travaux à proximité immédiate des réseaux et installations électriques.
          </p>
        </article>

        <!-- 4. CACES -->
        <article class="service-card sr sr-d1">
          <div class="service-num">04 / Certification</div>
          <h3>CACES® PEMP B (1B-3B) R486</h3>
          <p>
            Conduite certifiée de Plateformes Élévatrices Mobiles de Personnes à élévation multidirectionnelle (bras articulés, télescopiques, camions nacelles).
          </p>
        </article>

        <!-- 5. Sites nucléaires -->
        <article class="service-card sr sr-d2">
          <div class="service-num">05 / Haute Exigence</div>
          <h3>Accès Sites Nucléaires & Sensibles</h3>
          <p>
            Habilitations requises pour intervenir en milieux sensibles et centrales nucléaires, dans le respect absolu des procédures et normes de sécurité renforcée.
          </p>
        </article>

        <!-- 6. Mobilité -->
        <article class="service-card sr sr-d3">
          <div class="service-num">06 / Disponibilité</div>
          <h3>Mobilité sur Toute la France</h3>
          <p>
            Basé à Mérignac (33), déplacements rapides sur toute la France métropolitaine pour vos chantiers ponctuels ou missions de longue durée.
          </p>
        </article>
      </div>
    </section>

    <!-- === REAL INTERVENTIONS GALLERY (PHOTOS SUR LE TERRAIN) === -->
    <section id="galerie">
      <div class="section-header center sr">
        <div class="section-label">Sur le terrain</div>
        <h2 class="section-title">Nos Réalisations Réelles</h2>
        <p class="section-desc">
          Aperçu de nos interventions techniques en conditions réelles : pylônes télécoms, travaux de nuit, haute montagne et réseaux électriques.
        </p>
      </div>

      <div class="gallery-grid">
        <!-- Featured Night Pylon Shot -->
        <div class="gallery-featured-card sr">
          <div class="gallery-img-wrapper">
            <img
              src="/images/camion-nuit-lignes-electriques.png"
              alt="Intervention nocturne Z NACELLES sur pylône électrique haute tension"
              loading="lazy"
            />
            <div class="gallery-badge red">Habilitation HT / Nuit</div>
          </div>
          <div class="gallery-featured-content">
            <div class="featured-pill">⚡ Réseau Électrique & HT</div>
            <h3>Intervention de Nuit & Lignes Haute Tension (HT)</h3>
            <p>
              Manœuvre de précision et positionnement du bras élévateur à proximité d'un pylône haute tension. Respect rigoureux des distances de sécurité et des habilitations électriques requises.
            </p>
            <div>
              <a href="#contact" class="btn btn-primary" style="font-size: 0.95rem; padding: 10px 22px;">
                Demander une intervention
              </a>
            </div>
          </div>
        </div>

        <!-- Card 1: Telecom Pylon Structure -->
        <div class="gallery-card sr sr-d1">
          <div class="gallery-img-wrapper">
            <img
              src="/images/intervention-pylone-telecom.jpg"
              alt="Intervention Z NACELLES sur pylône relais et structure en hauteur"
              loading="lazy"
            />
            <div class="gallery-badge">Télécoms & Pylônes</div>
          </div>
          <div class="gallery-content">
            <h3>Pylônes Télécoms & Réseaux Mobiles</h3>
            <p>Chantier sur infrastructure de télécommunication et structure treillis pour déploiement d'antennes et relais de communication.</p>
          </div>
        </div>

        <!-- Card 2: Mountain High Altitude -->
        <div class="gallery-card sr sr-d2">
          <div class="gallery-img-wrapper">
            <img
              src="/images/intervention-montagne-haute-altitude.jpg"
              alt="Intervention Z NACELLES en haute montagne"
              loading="lazy"
            />
            <div class="gallery-badge">Haute Altitude</div>
          </div>
          <div class="gallery-content">
            <h3>Travaux en Haute Montagne & Sites Isolés</h3>
            <p>Intervention sur structures techniques et pylônes en conditions climatiques extrêmes avec équipement de protection individuel complet.</p>
          </div>
        </div>

        <!-- Card 3: Aerial Drone Shot -->
        <div class="gallery-card sr sr-d3">
          <div class="gallery-img-wrapper">
            <img
              src="/images/nacelle-drone-vue-aerienne.png"
              alt="Vue aérienne du camion nacelle télescopique Z NACELLES"
              loading="lazy"
            />
            <div class="gallery-badge">Flotte PEMP B</div>
          </div>
          <div class="gallery-content">
            <h3>Nacelle Télescopique Grand Déport</h3>
            <p>Vue aérienne de notre porteur lourd avec stabilisateurs déployés pour une portée et une hauteur d'intervention maximales.</p>
          </div>
        </div>

        <!-- Card 4: Team on Bridge / Worksite -->
        <div class="gallery-card sr sr-d1">
          <div class="gallery-img-wrapper">
            <img
              src="/images/equipe-nacelliste-chantier.jpg"
              alt="Opérateurs Z NACELLES sur ouvrage d'art"
              loading="lazy"
            />
            <div class="gallery-badge">Équipe & Sécurité</div>
          </div>
          <div class="gallery-content">
            <h3>Habilitation Hauteur sur Ouvrage d'Art</h3>
            <p>Opérations coordonnées en panier nacelle sécurisé pour maintenance d'infrastructures et d'ouvrages suspendus.</p>
          </div>
        </div>

        <!-- Card 5: Maritime / River Mast -->
        <div class="gallery-card sr sr-d2">
          <div class="gallery-img-wrapper">
            <img
              src="/images/intervention-hauteur-maritime.jpg"
              alt="Inspection technique de mât au-dessus de l'eau"
              loading="lazy"
            />
            <div class="gallery-badge">Télécom & Mât</div>
          </div>
          <div class="gallery-content">
            <h3>Inspection & Maintenance de Mâts Techniques</h3>
            <p>Accès difficile et interventions délicates au-dessus de plans d'eau pour maintenance de mâts, radars, antennes et faisceaux hertziens.</p>
          </div>
        </div>

        <!-- Card 6: High Steel Structure -->
        <div class="gallery-card sr sr-d3">
          <div class="gallery-img-wrapper">
            <img
              src="/images/intervention-structure-metallique.jpg"
              alt="Montage et vissage sur structure métallique en hauteur"
              loading="lazy"
            />
            <div class="gallery-badge">Grande Hauteur</div>
          </div>
          <div class="gallery-content">
            <h3>Montage & Structures Métalliques</h3>
            <p>Assistance au levage, ajustement et boulonnage en hauteur sur charpentes industrielles et pylônes techniques.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- === ABOUT SECTION === -->
    <section id="about">
      <div class="about-grid">
        <div class="about-content sr">
          <div class="section-label">Engagement & Équipement</div>
          <h2 class="section-title">Nacelliste Professionnel Indépendant</h2>
          <p>
            <strong>Z NACELLES</strong> vous accompagne avec rigueur et disponibilité. Basé au <strong>26 av. Gustave Eiffel à Mérignac</strong>, j'assure la conduite sécurisée de nacelles élévatrices avec une spécialisation forte dans les <strong>réseaux de télécommunications (antennes 4G/5G, pylônes relais, FH)</strong>, le BTP, l'industrie, les réseaux d'énergie et les sites sensibles.
          </p>
          <p>
            Un interlocuteur unique sur votre chantier, un matériel professionnel contrôlé et toutes les habilitations indispensables pour garantir la réussite et la conformité totale de vos opérations.
          </p>
          <div class="about-specs-grid">
            <div class="spec-pill"><span class="check">✓</span> Pylônes Télécoms 4G/5G</div>
            <div class="spec-pill"><span class="check">✓</span> Habilitation Travaux en Hauteur</div>
            <div class="spec-pill"><span class="check">✓</span> CACES® R486 1B/3B PEMP B</div>
            <div class="spec-pill"><span class="check">✓</span> Habilitations Électriques BT & HT</div>
            <div class="spec-pill"><span class="check">✓</span> Accès Sites Sensibles & Nucléaire</div>
            <div class="spec-pill"><span class="check">✓</span> Déplacements France Entière</div>
          </div>
        </div>

        <!-- Real Fleet Photo Card -->
        <div class="about-photo-card sr sr-d2">
          <img
            src="/images/camion-nacelle-flotte.png"
            alt="Camion nacelle Z NACELLES avec stabilisateurs déployés"
            loading="lazy"
          />
          <div class="about-photo-overlay">
            <div>
              <div class="about-overlay-badge">Flotte Z NACELLES</div>
              <div style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; color: #fff; margin-top: 4px;">
                Location de Nacelle avec Opérateur
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- === CONTACT SECTION === -->
    <section id="contact">
      <div class="section-header center sr">
        <div class="section-label">Coordonnées</div>
        <h2 class="section-title">Contact Direct</h2>
        <p class="section-desc">
          Un chantier télécom, une urgence ou un devis d'intervention ? Envoyez votre demande, elle arrive directement sur ma boîte mail.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Live Form via FormSubmit -->
        <form
          class="contact-form sr"
          id="contactForm"
          action="https://formsubmit.co/ajax/z.nacelles@gmail.com"
          method="POST"
          aria-label="Formulaire de contact"
        >
          <!-- Anti-spam & Configuration -->
          <input type="hidden" name="_subject" value="Nouveau message depuis le site Z NACELLES" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />

          <div class="field">
            <label for="name">Nom / Société *</label>
            <input type="text" id="name" name="nom_ou_societe" placeholder="Votre nom ou entreprise" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Adresse Email *</label>
            <input type="email" id="email" name="email" placeholder="votre@email.com" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Téléphone *</label>
            <input type="tel" id="phone" name="telephone" placeholder="06 00 00 00 00" required autocomplete="tel" />
          </div>
          <div class="field">
            <label for="message">Détails de l'intervention *</label>
            <textarea id="message" name="message" placeholder="Type de travaux (Télécoms, Pylônes, BTP, Électricité...), hauteur estimée, lieu, dates souhaitées..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" id="submitBtn" style="width: 100%; justify-content: center;">
            Envoyer ma demande
          </button>
          <div id="formStatus" style="display: none; padding: 14px; border-radius: 6px; font-size: 0.92rem; text-align: center; margin-top: 6px; line-height: 1.5;"></div>
        </form>

        <!-- Coordinates Stack -->
        <div class="contact-cards-stack sr sr-d2">
          <div class="contact-info-card">
            <div class="c-icon-badge">📞</div>
            <div>
              <div class="c-detail-title">Téléphone Direct</div>
              <div class="c-detail-val"><a href="tel:+33767341655">07 67 34 16 55</a></div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="c-icon-badge">✉️</div>
            <div>
              <div class="c-detail-title">Email Professionnel</div>
              <div class="c-detail-val"><a href="mailto:z.nacelles@gmail.com">z.nacelles@gmail.com</a></div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="c-icon-badge">📍</div>
            <div>
              <div class="c-detail-title">Adresse</div>
              <div class="c-detail-val">26 av. Gustave Eiffel, 33700 MÉRIGNAC</div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="c-icon-badge">🗺️</div>
            <div>
              <div class="c-detail-title">Rayon d'action</div>
              <div class="c-detail-val">Toute la France métropolitaine</div>
            </div>
          </div>

          <!-- Google Maps iframe -->
          <div class="contact-map-frame">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2829.7!2d-0.6413!3d44.8314!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd54d86b2c4f2e43%3A0x0!2s26+Avenue+Gustave+Eiffel%2C+33700+M%C3%A9rignac!5e0!3m2!1sfr!2sfr!4v1700000000000!5m2!1sfr!2sfr"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Z NACELLES — Mérignac"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- === FOOTER === -->
  <footer>
    <div class="footer-inner">
      <div class="footer-logo-line">
        <ZLogo width={28} height={28} className="brand-emblem" />
        <span class="brand-title" style="font-size: 1.05rem;">Z NACELLES</span>
