---
import Layout from '../layouts/Layout.astro';
import ZLogo from '../components/ZLogo.astro';
---

<Layout
  title="Z NACELLES | Nacelliste Professionnel — Mérignac (33) | France Entière"
  description="Z NACELLES — Nacelliste professionnel. Interventions grandes hauteurs, habilitations électriques BT & HT, CACES® PEMP B R486, accès sites nucléaires. Mobilité sur toute la France."
>
  <!-- === NAVBAR === -->
  <header>
    <nav class="nav" id="nav" role="navigation" aria-label="Navigation principale">
      <a href="#hero" class="nav-brand" aria-label="Z NACELLES - Accueil">
        <ZLogo width={36} height={36} className="brand-emblem" />
        <div class="brand-text-block">
          <span class="brand-title">Z NACELLES</span>
          <span class="brand-subtitle">Nacelliste Professionnel</span>
        </div>
      </a>
      <ul class="nav-links" id="navLinks">
        <li><a href="#services">Services</a></li>
        <li><a href="#about">À propos</a></li>
        <li><a href="#contact" class="nav-cta">Contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <main>
    <!-- === HERO SECTION === -->
    <section class="hero" id="hero">
      <div class="hero-container">
        <div class="hero-logo-box sr">
          <ZLogo width={110} height={70} className="hero-emblem-large" />
          <h1 class="hero-brand-name">Z NACELLES</h1>
          <div class="hero-badge-tag">Nacelliste Professionnel</div>
        </div>

        <p class="hero-desc sr sr-d1">
          Solutions sur mesure pour vos travaux en grandes hauteurs. Opérateur qualifié, matériel certifié et mobilité sur l'ensemble du territoire national.
        </p>

        <div class="hero-actions sr sr-d2">
          <a href="#contact" class="btn btn-primary">
            Demander un devis
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="tel:+33767341655" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            07 67 34 16 55
          </a>
        </div>

        <!-- Contact bar directly from card footer -->
        <div class="hero-card-strip sr sr-d3">
          <div class="strip-item">
            <span>📞</span>
            <a href="tel:+33767341655">07 67 34 16 55</a>
          </div>
          <span class="strip-dot">■</span>
          <div class="strip-item">
            <span>✉️</span>
            <a href="mailto:z.nacelles@gmail.com">z.nacelles@gmail.com</a>
          </div>
          <span class="strip-dot">■</span>
          <div class="strip-item">
            <span>📍</span>
            <span>26 av. Gustave Eiffel, 33700 MÉRIGNAC</span>
          </div>
        </div>
      </div>
    </section>

    <!-- === BUSINESS CARD SHOWCASE SECTION === -->
    <div class="business-card-section sr">
      <div class="card-showcase-grid">
        <!-- Front Card Preview -->
        <div class="card-preview-box card-front">
          <div>
            <ZLogo width={80} height={50} className="card-front-emblem" />
            <div class="card-front-title">Z NACELLES</div>
            <div class="card-front-sub">NACELLISTE PROFESSIONNEL</div>
          </div>
          <div class="card-front-contact">
            <div>07 67 34 16 55 <span class="sq">■</span> z.nacelles@gmail.com</div>
            <div>26 av. Gustave Eiffel <span class="sq">■</span> 33700 MÉRIGNAC</div>
          </div>
        </div>

        <!-- Back Card Preview -->
        <div class="card-preview-box card-back">
          <div class="card-back-title">Domaines d'intervention</div>
          <ul class="card-back-list">
            <li>
              <span class="glow-bullet"></span>
              <span>Interventions grandes hauteurs, solutions sur mesure</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Habilitations électriques BT & HT</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>CACES® PEMP B (1B-3B) R486</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Accès sites nucléaires</span>
            </li>
            <li>
              <span class="glow-bullet"></span>
              <span>Mobilité sur toute la France</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- === SERVICES SECTION (DIRECTLY FROM CARD) === -->
    <section id="services">
      <div class="section-header center sr">
        <div class="section-label">Expertises & Certifications</div>
        <h2 class="section-title">Nos Prestations</h2>
        <p class="section-desc">
          Une réponse rigoureuse et sécurisée pour chacun de vos chantiers en hauteur.
        </p>
      </div>

      <div class="services-grid">
        <!-- 1. Grandes hauteurs -->
        <article class="service-card sr sr-d1">
          <div class="service-num">01 / Spécialité</div>
          <h3>Interventions Grandes Hauteurs</h3>
          <p>
            Solutions sur mesure adaptées aux contraintes techniques de votre site. Maintenance, levage, montage, nettoyage et inspections techniques en hauteur.
          </p>
        </article>

        <!-- 2. Habilitations électriques -->
        <article class="service-card sr sr-d2">
          <div class="service-num">02 / Sécurité</div>
          <h3>Habilitations Électriques BT & HT</h3>
          <p>
            Opérateur habilité Basse Tension (BT) et Haute Tension (HT) pour des manœuvres et travaux à proximité immédiate des réseaux et installations électriques.
          </p>
        </article>

        <!-- 3. CACES -->
        <article class="service-card sr sr-d3">
          <div class="service-num">03 / Certification</div>
          <h3>CACES® PEMP B (1B-3B) R486</h3>
          <p>
            Conduite certifiée de Plateformes Élévatrices Mobiles de Personnes à élévation multidirectionnelle (bras articulés, télescopiques, camions nacelles).
          </p>
        </article>

        <!-- 4. Sites nucléaires -->
        <article class="service-card sr sr-d1">
          <div class="service-num">04 / Haute Exigence</div>
          <h3>Accès Sites Nucléaires</h3>
          <p>
            Habilitations requises pour intervenir en milieux sensibles et centrales nucléaires, dans le respect absolu des procédures et normes de sécurité.
          </p>
        </article>

        <!-- 5. Mobilité -->
        <article class="service-card sr sr-d2">
          <div class="service-num">05 / Disponibilité</div>
          <h3>Mobilité sur Toute la France</h3>
          <p>
            Basé à Mérignac (33), déplacements rapides sur toute la France métropolitaine pour vos chantiers ponctuels ou missions de longue durée.
          </p>
        </article>
      </div>
    </section>

    <!-- === ABOUT SECTION === -->
    <section id="about">
      <div class="about-grid">
        <div class="about-content sr">
          <div class="section-label">Engagement</div>
          <h2 class="section-title">Nacelliste Professionnel Indépendant</h2>
          <p>
            <strong>Z NACELLES</strong> vous accompagne avec rigueur et disponibilité. Basé au <strong>26 av. Gustave Eiffel à Mérignac</strong>, j'assure la conduite sécurisée de nacelles élévatrices pour entreprises du BTP, de l'industrie et de l'énergie.
          </p>
          <p>
            Un interlocuteur unique, du matériel contrôlé et des habilitations vérifiées pour garantir la fluidité et la conformité de vos opérations en hauteur.
          </p>
          <div class="about-specs-grid">
            <div class="spec-pill"><span class="check">✓</span> CACES® R486 1B/3B</div>
            <div class="spec-pill"><span class="check">✓</span> Habilitations BT & HT</div>
            <div class="spec-pill"><span class="check">✓</span> Accès Sites Sensibles</div>
            <div class="spec-pill"><span class="check">✓</span> Intervention France Entière</div>
          </div>
        </div>

        <div class="about-visual-card sr sr-d2">
          <div class="visual-truck-badge">Camion Nacelle PEMP B</div>
          <div class="about-visual-title">Z NACELLES</div>
          <p class="about-visual-sub">
            Conduite experte & sécurité maximale sur vos chantiers.
          </p>
          <div style="margin-top: 20px;">
            <a href="#contact" class="btn btn-primary" style="font-size: 0.95rem; padding: 10px 24px;">Demander une intervention</a>
          </div>
        </div>
      </div>
    </section>

    <!-- === CONTACT SECTION === -->
    <section id="contact">
      <div class="section-header center sr">
        <div class="section-label">Coordonnées</div>
        <h2 class="section-title">Contact Direct</h2>
        <p class="section-desc">
          Une question, une urgence ou un devis d'intervention ? Contactez-moi par téléphone ou via le formulaire.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Form -->
        <form class="contact-form sr" id="contactForm" aria-label="Formulaire de contact">
          <div class="field">
            <label for="name">Nom / Société</label>
            <input type="text" id="name" placeholder="Votre nom ou entreprise" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Adresse Email</label>
            <input type="email" id="email" placeholder="votre@email.com" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Téléphone</label>
            <input type="tel" id="phone" placeholder="06 00 00 00 00" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="message">Détails de l'intervention</label>
            <textarea id="message" placeholder="Type de travaux, hauteur estimée, lieu, dates souhaitées..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Envoyer ma demande
          </button>
        </form>

        <!-- Coordinates Stack -->
        <div class="contact-cards-stack sr sr-d2">
          <div class="contact-info-card">
            <div class="c-icon-badge">📞</div>
            <div>
              <div class="c-detail-title">Téléphone Direct</div>
              <div class="c-detail-val"><a href="tel:+33767341655">07 67 34 16 55</a></div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="c-icon-badge">✉️</div>
            <div>
              <div class="c-detail-title">Email Professionnel</div>
              <div class="c-detail-val"><a href="mailto:z.nacelles@gmail.com">z.nacelles@gmail.com</a></div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="c-icon-badge">📍</div>
            <div>
              <div class="c-detail-title">Adresse</div>
              <div class="c-detail-val">26 av. Gustave Eiffel, 33700 MÉRIGNAC</div>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="c-icon-badge">🗺️</div>
            <div>
              <div class="c-detail-title">Rayon d'action</div>
              <div class="c-detail-val">Toute la France métropolitaine</div>
            </div>
          </div>

          <!-- Google Maps iframe -->
          <div class="contact-map-frame">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2829.7!2d-0.6413!3d44.8314!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd54d86b2c4f2e43%3A0x0!2s26+Avenue+Gustave+Eiffel%2C+33700+M%C3%A9rignac!5e0!3m2!1sfr!2sfr!4v1700000000000!5m2!1sfr!2sfr"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Z NACELLES — Mérignac"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- === FOOTER === -->
  <footer>
    <div class="footer-inner">
      <div class="footer-logo-line">
        <ZLogo width={28} height={28} className="brand-emblem" />
        <span class="brand-title" style="font-size: 1.05rem;">Z NACELLES</span>
      </div>
      <p class="footer-copy">
        Nacelliste Professionnel — 26 av. Gustave Eiffel, 33700 MÉRIGNAC — 07 67 34 16 55 — z.nacelles@gmail.com
      </p>
      <p class="footer-copy" style="opacity: 0.6; font-size: 0.75rem;">
        © {new Date().getFullYear()} Z NACELLES. Tous droits réservés.
      </p>
    </div>
  </footer>

  <!-- WhatsApp Floating Button -->
  <a
    href="https://wa.me/33767341655"
    target="_blank"
    rel="noopener noreferrer"
    class="wa-float"
    aria-label="WhatsApp"
    title="Nous contacter sur WhatsApp"
  >
    <svg viewBox="0 0 24 24">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
  </a>

  <!-- Back to top button -->
  <button class="to-top" id="toTop" aria-label="Retour en haut">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 15l-6-6-6 6"></path>
    </svg>
  </button>
</Layout>
